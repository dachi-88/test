# Copy to .env and fill in to enable live Claude-powered agents.
# If ANTHROPIC_API_KEY is unset, the system runs in deterministic MOCK mode
# (no network calls) so the demo and tests work fully offline.

ANTHROPIC_API_KEY=
# Default model used by every agent unless overridden per-agent.
PROCUREMENT_MODEL=claude-opus-4-8
# HTTP port for `npm run serve`
PORT=8787
